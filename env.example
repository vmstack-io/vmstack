# Copy this file to .env and fill in your values.

# URL your users will use to reach the portal
VMSTACK_URL=http://vmstack.example.lan:8080

# Random secret - generate with: openssl rand -hex 32
VMSTACK_SECRET=change-me

# Email for the first admin account
VMSTACK_ADMIN_EMAIL=admin@example.com

# Timezone
TZ=Europe/Brussels
